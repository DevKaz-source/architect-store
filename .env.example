APP_ENV=development
APP_BASE_URL=https://SEU-DOMINIO.com
DATABASE_URL=postgresql+asyncpg://store:troque-esta-senha@db:5432/store
POSTGRES_PASSWORD=troque-esta-senha
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO

# Crie o bot no @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
# 16 a 256 caracteres: letras, números, _ e -. Use scripts/generate_secrets.py.
TELEGRAM_WEBHOOK_SECRET=
# IDs numéricos separados por vírgula.
ADMIN_TELEGRAM_IDS=
# Grupo privado de suporte. Se vazio, os administradores recebem os chamados.
SUPPORT_CHAT_ID=

# "mock" funciona sem cobrar e serve apenas para desenvolvimento.
# Troque para "mercado_pago" depois de concluir os testes oficiais.
PIX_PROVIDER=mock
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# true somente com credenciais de teste; envia o cenário oficial payer.first_name=APRO.
MERCADO_PAGO_TEST_MODE=false
PIX_EXPIRATION_MINUTES=30
MIN_TOPUP_CENTS=500
MAX_TOPUP_CENTS=200000
MAX_OPEN_DEPOSITS_PER_USER=3
MAX_OPEN_TICKETS_PER_USER=3

# Fornecedor automático: "none", "mock" ou "reloadly".
# O mock é local, não faz chamadas externas e só funciona fora de produção.
GIFTCARD_PROVIDER=none
# success, pending_then_success, ambiguous_then_success ou reject.
MOCK_SUPPLIER_SCENARIO=success

# Reloadly. Comece obrigatoriamente em sandbox.
# RELOADLY_ENABLED existe apenas para compatibilidade; prefira GIFTCARD_PROVIDER=reloadly.
RELOADLY_ENABLED=false
RELOADLY_ENVIRONMENT=sandbox
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SENDER_NAME=Architect Store
# Trava extra: só use true após homologação, saldo LIVE e APP_ENV=production.
RELOADLY_LIVE_ENABLED=false
RELOADLY_TIMEOUT_SECONDS=20
SUPPLIER_RECONCILE_SECONDS=60
# 500 = margem bruta mínima de 5%: (venda - custo) / venda.
MIN_SUPPLIER_GROSS_MARGIN_BPS=500

# Chave Fernet usada para criptografar estoque e mensagens de suporte.
DATA_ENCRYPTION_KEY=

TERMS_URL=https://SEU-DOMINIO.com/termos
PRIVACY_URL=https://SEU-DOMINIO.com/privacidade
